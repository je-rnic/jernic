{
	"name": "nextjs",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.mjs",
		"visual:capture": "node tests/visual.mjs capture",
		"visual:compare": "node tests/visual.mjs compare",
		"format:check": "prettier --check \"src/components/**/*.{ts,tsx}\" \"src/styles/**/*.css\" \"tests/**/*.{mjs,tsx}\" mdx-components.tsx",
		"test:interaction": "node tests/interaction.mjs"
	},
	"dependencies": {
		"@mdx-js/loader": "^3.1.1",
		"@mdx-js/react": "^3.1.1",
		"@next/mdx": "^16.4.3",
		"@vercel/analytics": "^2.0.1",
		"locomotive-scroll": "5.0.0-beta.21",
		"next": "^16.4.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@mdx-js/mdx": "^3.1.1",
		"@playwright/test": "^1.65.0",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3"
	}
}
